rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ── Role helpers (custom claims set by the setStaffClaims function) ── */
    function isStaff()   { return request.auth != null && request.auth.token.staff == true; }
    function isAdmin()   { return isStaff() && request.auth.token.role == 'admin'; }
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function isSeller() { return request.auth != null && request.auth.token.seller == true; }

    /* ── Staff directory ── */
    // Cloud Functions (admin SDK) bypass these rules when creating staff.
    match /staff/{uid} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }

    /* ── Student accounts ── */
    // Created by the studentSignup function (admin SDK bypasses rules).
    // The owner (auth.uid == accountId, via custom token) reads/updates their
    // own account; staff read all; admins have full write.
    match /accounts/{id} {
      allow read:   if isStaff() || isOwner(id);
      // The owner may update their own profile fields but NOT their wallet
      // balance — that is server-authoritative. Cloud Functions (admin SDK)
      // bypass these rules; admins match isAdmin().
      allow update: if isAdmin()
                    || (isOwner(id)
                        && request.resource.data.walletBalanceKsh == resource.data.walletBalanceKsh);
      allow create, delete: if isAdmin();

      // Account subcollections: learning progress + revisions are owner/staff
      // read-write; the walletTx ledger is written only by Cloud Functions.
      match /{sub}/{docId} {
        allow read:  if isStaff() || isOwner(id);
        allow write: if (isStaff() || isOwner(id)) && sub != 'walletTx';
      }
    }

    /* ── Support chat ── */
    match /conversations/{cid} {
      allow read:   if isStaff() || isOwner(resource.data.userUid);
      // A visitor may open exactly one conversation tagged with their own uid.
      allow create: if isOwner(request.resource.data.userUid);
      // Owner may only reset their own unread badge; staff may manage freely.
      allow update: if isStaff()
                    || (isOwner(resource.data.userUid)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadForUser']));
      allow delete: if isAdmin();

      match /messages/{mid} {
        function convOwner() {
          return get(/databases/$(database)/documents/conversations/$(cid)).data.userUid;
        }
        allow read:   if isStaff() || isOwner(convOwner());
        allow create: if isStaff() || isOwner(convOwner());
        allow update, delete: if isAdmin();
      }
    }

    /* ── Content (games, exams, questions, leaderboard, packages) ── */
    // Publicly readable, only admins write (via panel or seed script).
    match /games/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /subjects/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /topics/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /questions/{id}   { allow read: if true; allow write: if isAdmin(); }
    // Students submit their own scores; admins moderate (feature/flag/delete).
    match /leaderboard/{id} {
      allow read:   if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }
    match /packages/{id}    { allow read: if true; allow write: if isAdmin(); }
    // Community feed: anyone may read; signed-in learners may post; admins moderate.
    match /community/{id} {
      allow read:   if true;
      allow create: if request.auth != null
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500;
      allow update, delete: if isAdmin();
    }
    match /exams/{id} {
      allow read: if true; allow write: if isAdmin();
      match /questions/{qid} { allow read: if true; allow write: if isAdmin(); }
    }

    /* ── Marketplace sellers ── */
    // Created by the sellerSignup function (admin SDK bypasses rules).
    // A seller reads only their own doc; staff read all; balances/status
    // are written by Cloud Functions or admins, never by the seller.
    match /sellers/{id} {
      allow read:   if isStaff() || (isSeller() && request.auth.uid == id);
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    /* ── Marketplace resources ── */
    // A seller creates/edits/deletes only their own resources. Published
    // resources are world-readable (buyer browse, a later slice); drafts are
    // visible only to their owner and staff. The owner cannot be reassigned.
    match /resources/{id} {
      allow read:   if resource.data.status == 'published'
                    || isStaff()
                    || (isSeller() && request.auth.uid == resource.data.sellerId);
      allow create: if isSeller()
                    && request.auth.uid == request.resource.data.sellerId;
      allow update: if (isSeller()
                        && request.auth.uid == resource.data.sellerId
                        && request.resource.data.sellerId == resource.data.sellerId)
                    || isAdmin();
      allow delete: if (isSeller() && request.auth.uid == resource.data.sellerId)
                    || isAdmin();
    }

    /* ── Marketplace orders (purchases), commission ledger, settings ── */
    // Purchases and ledger are written only by Cloud Functions (money logic is
    // server-authoritative). Buyers read their own orders; staff read all.
    match /purchases/{id} {
      allow read:  if isStaff()
                   || (request.auth != null && request.auth.uid == resource.data.buyerAccountId);
      allow write: if false;
    }
    match /ledger/{id} {
      allow read:  if isStaff();
      allow write: if false;
    }
    // Commission % etc. — world-readable (checkout needs it), admin-writable.
    match /platformSettings/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    /* Everything else is denied by default. */
  }
}
