rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Gated primary media (video/audio). NOT publicly readable — buyers stream
    // it via short-lived signed URLs from the getResourceMediaUrl function.
    // Only the owning seller may read/write their own media directly.
    match /media/{sellerId}/{allPaths=**} {
      allow read:  if request.auth != null
                   && request.auth.uid == sellerId
                   && request.auth.token.seller == true;
      allow write: if request.auth != null
                   && request.auth.uid == sellerId
                   && request.auth.token.seller == true
                   && (request.resource == null || request.resource.size < 500 * 1024 * 1024);
    }

    // Sellers upload resource files/thumbnails under their own prefix.
    // Public read (paid-file gating is deferred to the payments slice).
    match /marketplace/{sellerId}/{allPaths=**} {
      allow read:  if true;
      // `write` covers create/update/delete. On delete there is no incoming
      // object (request.resource == null), so only size-check actual uploads.
      allow write: if request.auth != null
                   && request.auth.uid == sellerId
                   && request.auth.token.seller == true
                   && (request.resource == null || request.resource.size < 50 * 1024 * 1024);
    }

    // Game banners, exam images, avatars — public read, admin-only write.
    match /{allPaths=**} {
      // Everything is publicly readable EXCEPT gated media (video/audio), which
      // is owner-only above and streamed to buyers via signed URLs.
      allow read: if !string(allPaths).matches('media/.*');
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
